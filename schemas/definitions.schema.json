{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autogoods.inc/definitions.schema.json",
  "title": "Auto Goods Shared Definitions",
  "type": "object",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$",
      "minLength": 3,
      "maxLength": 128
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_minor",
        "currency"
      ],
      "properties": {
        "amount_minor": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_uri",
        "collected_at",
        "content_sha256",
        "collector_id",
        "collection_method"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_uri": {
          "$ref": "#/$defs/uri"
        },
        "collected_at": {
          "$ref": "#/$defs/timestamp"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "collector_id": {
          "$ref": "#/$defs/identifier"
        },
        "collection_method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceLabel": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "INFERRED",
        "SPECULATIVE",
        "NOT_COMPUTABLE"
      ]
    },
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "label",
        "evidence_ids",
        "provenance"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/evidenceLabel"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "OBSERVED"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "INFERRED"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "provenance": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "HUMAN",
            "AGENT",
            "SYSTEM",
            "ORGANIZATION"
          ]
        }
      }
    }
  }
}
