{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autogoods.inc/impact-receipt.schema.json",
  "title": "ImpactReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "impact_receipt_id": {"$ref": "definitions.schema.json#/$defs/identifier"},
    "allocation_id": {"$ref": "definitions.schema.json#/$defs/identifier"},
    "source_distribution_period": {"$ref": "definitions.schema.json#/$defs/identifier"},
    "source_ventures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "definitions.schema.json#/$defs/identifier"}},
    "recipient_organization": {"$ref": "definitions.schema.json#/$defs/identifier"},
    "recipient_program": {"$ref": "definitions.schema.json#/$defs/identifier"},
    "amount": {"$ref": "definitions.schema.json#/$defs/money"},
    "domain": {"enum": ["food", "housing", "healthcare", "education", "community_space"]},
    "funded_activity": {"type": "string", "minLength": 1},
    "expected_output": {"type": "string", "minLength": 1},
    "actual_output": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "definitions.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "verification_state": {"enum": ["PENDING", "VERIFIED", "REJECTED", "NOT_COMPUTABLE"]},
    "verified_by": {"oneOf": [{"$ref": "definitions.schema.json#/$defs/actor"}, {"type": "null"}]},
    "issued_at": {"$ref": "definitions.schema.json#/$defs/timestamp"},
    "public_provenance_id": {"$ref": "definitions.schema.json#/$defs/identifier"}
  },
  "required": ["impact_receipt_id", "allocation_id", "source_distribution_period", "source_ventures", "recipient_organization", "recipient_program", "amount", "domain", "funded_activity", "expected_output", "actual_output", "evidence", "verification_state", "verified_by", "issued_at", "public_provenance_id"]
}
