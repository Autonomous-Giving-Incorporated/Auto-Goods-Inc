{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autogoods.inc/community-organization.schema.json",
  "title": "CommunityOrganization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "organization_id": {"$ref": "definitions.schema.json#/$defs/identifier"},
    "legal_name": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "eligible_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["food", "housing", "healthcare", "education", "community_space"]}},
    "identity_verification": {"enum": ["PENDING", "VERIFIED", "FAILED", "EXPIRED"]},
    "legal_status": {"enum": ["PENDING", "VERIFIED", "INELIGIBLE", "EXPIRED"]},
    "bank_verification_state": {"enum": ["NOT_STARTED", "PENDING", "VERIFIED", "FAILED", "EXPIRED"]},
    "operating_history": {"type": "string", "minLength": 1},
    "reporting_state": {"enum": ["CURRENT", "DUE", "DELINQUENT", "SUSPENDED"]},
    "programs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"program_id": {"$ref": "definitions.schema.json#/$defs/identifier"}, "name": {"type": "string", "minLength": 1}, "domain": {"enum": ["food", "housing", "healthcare", "education", "community_space"]}}, "required": ["program_id", "name", "domain"]}},
    "population_served": {"type": "string", "minLength": 1},
    "service": {"type": "string", "minLength": 1},
    "geography": {"type": "string", "minLength": 1},
    "capacity": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "definitions.schema.json#/$defs/identifier"}},
    "source_documents": {"type": "array", "minItems": 1, "items": {"$ref": "definitions.schema.json#/$defs/provenance"}},
    "impact_reports": {"type": "array", "items": {"$ref": "definitions.schema.json#/$defs/identifier"}},
    "verified_at": {"oneOf": [{"$ref": "definitions.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "verified_by": {"oneOf": [{"$ref": "definitions.schema.json#/$defs/actor"}, {"type": "null"}]}
  },
  "required": ["organization_id", "legal_name", "location", "eligible_domains", "identity_verification", "legal_status", "bank_verification_state", "operating_history", "reporting_state", "programs", "population_served", "service", "geography", "capacity", "evidence", "source_documents", "impact_reports", "verified_at", "verified_by"]
}
